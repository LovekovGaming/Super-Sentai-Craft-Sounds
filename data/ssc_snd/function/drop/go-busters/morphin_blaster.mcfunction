execute if entity @n[type=item,distance=..5,tag=pick_up] run stopsound @a[scores={ssc.configs.change_snd=1},distance=..20] player minecraft:entity.item.pickup
execute if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run scoreboard players add @s ssc.change-stage 1

execute if score @s ssc.change-stage matches 1 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run playsound supersentaicraft:morphin_blaster_gun_mode player @a[scores={ssc.configs.change_snd=1}] ~ ~1 ~
execute if score @s ssc.change-stage matches 2 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster unless predicate ssc_core:sneaking run title @a[scores={ssc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.supersentaicraft.go-busters.its_morphin_time","color":"yellow"}
execute if score @s ssc.change-stage matches 2 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster unless predicate ssc_core:sneaking run playsound supersentaicraft:its_morphin_time player @a[scores={ssc.configs.change_snd=1}] ~ ~1 ~
execute if score @s ssc.change-stage matches 2 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster if predicate ssc_core:sneaking run scoreboard players set @s ssc.seq1 27
execute if score @s ssc.change-stage matches 2 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run advancement grant @s only ssc_snd:change/go-busters/morphin_blaster_standby 1
execute if score @s ssc.change-stage matches 3 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run playsound supersentaicraft:morphin_brace_open player @a[scores={ssc.configs.change_snd=1}] ~ ~1 ~
execute if score @s ssc.change-stage matches 3 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run stopsound @a[scores={ssc.configs.change_snd=1},distance=..20] player supersentaicraft:morphin_blaster_standby
execute if score @s ssc.change-stage matches 3 if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run advancement revoke @s from ssc_snd:change/go-busters/standby_root

execute if score @s ssc.change-stage matches 4 if items entity @s container.* supersentaicraft:beet_morphin_blaster unless items entity @s armor.feet #ssc_snd:changers/morphin_blaster if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/equip_belt {slot: "belt.feet", item: "supersentaicraft:beet_morphin_blaster"}
execute if score @s ssc.change-stage matches 4 if items entity @s container.* supersentaicraft:stag_morphin_blaster unless items entity @s armor.feet #ssc_snd:changers/morphin_blaster if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/equip_belt {slot: "belt.feet", item: "supersentaicraft:stag_morphin_blaster"}
execute if score @s ssc.change-stage matches 4 if items entity @s container.* supersentaicraft:enter_morphin_blaster unless items entity @s armor.feet #ssc_snd:changers/morphin_blaster if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/equip_belt {slot: "belt.feet", item: "supersentaicraft:enter_morphin_blaster"}
execute if score @s ssc.change-stage matches 4 if items entity @s container.* supersentaicraft:beetle_morphin_blaster unless items entity @s armor.feet #ssc_snd:changers/morphin_blaster if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/equip_belt {slot: "belt.feet", item: "supersentaicraft:beetle_morphin_blaster"}
execute if score @s ssc.change-stage matches 4 unless predicate ssc_core:sneaking if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/equip_belt {slot: "belt.feet", item: "supersentaicraft:beet_morphin_blaster"}
execute if score @s ssc.change-stage matches 4 if predicate ssc_core:sneaking if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/equip_belt {slot: "belt.feet", item: "supersentaicraft:stag_morphin_blaster"}
execute if score @s ssc.change-stage matches 4.. if items entity @n[type=item,distance=..5,predicate=ssc_snd:valid_item] contents supersentaicraft:morphin_blaster run scoreboard players reset @s ssc.change-stage
execute as @n[type=item,distance=..5,predicate=ssc_snd:valid_item] if items entity @s contents supersentaicraft:morphin_blaster run function ssc_snd:drop/common/return_item
advancement revoke @s from ssc_snd:drop/go-busters/root