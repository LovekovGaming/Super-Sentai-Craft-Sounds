execute if score @s ssc.change-stage matches 7 if entity @n[type=item,distance=..5,tag=valid] run advancement revoke @s from ssc_snd:change/boonboomger/standby_root
execute unless items entity @s armor.feet supersentaicraft:violet_boonboom_controller if score @s ssc.change-stage matches 7 if entity @n[type=item,distance=..5,tag=valid] run advancement revoke @s from ssc_snd:change/boonboomger/root
