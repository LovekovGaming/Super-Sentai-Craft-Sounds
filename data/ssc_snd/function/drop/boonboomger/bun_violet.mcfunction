execute if score @s ssc.change-stage matches 6 if items entity @n[type=item,distance=..5,tag=valid] contents supersentaicraft:boonboom_controller_bowgun if entity @n[type=item,distance=..5,tag=valid] run title @a[scores={ssc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.supersentaicraft.boonboomger.byunbyunbyum","color":"aqua"}
